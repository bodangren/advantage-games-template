{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@reading-advantage/game-contracts": ["./packages/game-contracts/src/index.ts"],
      "@reading-advantage/advantage-play-kit": ["./packages/advantage-play-kit/src/index.ts"],
      "@reading-advantage/advantage-play-kit/runtime": ["./packages/advantage-play-kit/src/runtime.ts"],
      "@reading-advantage/advantage-play-kit/systems": ["./packages/advantage-play-kit/src/systems.ts"],
      "@reading-advantage/advantage-play-kit/responsive": ["./packages/advantage-play-kit/src/responsive.ts"],
      "@reading-advantage/advantage-play-kit/scaffolding": ["./packages/advantage-play-kit/src/scaffolding.ts"],
      "@reading-advantage/game-cartridges": ["./packages/game-cartridges/src/index.ts"]
    }
  },
  "include": [
    "apps/game-lab/**/*.ts",
    "apps/game-lab/**/*.tsx",
    "packages/**/*.ts",
    "packages/**/*.tsx",
    "tests/**/*.ts",
    "playwright.config.ts",
    "vitest.config.ts"
  ]
}
