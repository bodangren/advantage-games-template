{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "cartridgeId", "cartridgePath", "inputMode", "runtimeApiVersion"],
  "properties": {
    "schemaVersion": { "const": "advantage-game-submission.v1" },
    "cartridgeId": { "type": "string", "pattern": "^contestant\\.[a-z0-9-]+$" },
    "cartridgePath": { "const": "packages/game-cartridges/src/cartridges/my-game" },
    "inputMode": { "enum": ["vocabulary", "sentence"] },
    "runtimeApiVersion": { "const": "1.0.0" }
  }
}
