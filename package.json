{
  "name": "advantage-games-template",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.8.0",
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "dev": "vite --config apps/game-lab/vite.config.ts",
    "build": "vite build --config apps/game-lab/vite.config.ts",
    "check-types": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run packages/advantage-play-kit/src/competition-palette.test.ts packages/game-cartridges/src/cartridges/my-game/systems.test.ts",
    "validate:submission": "node scripts/validate-submission.mjs",
    "validate:import": "node scripts/validate-import.mjs",
    "validate": "pnpm validate:submission && pnpm check-types && pnpm test && pnpm build && pnpm validate:import"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "phaser": "4.2.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "vite": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "typescript": "7.0.2",
    "vitest": "latest"
  }
}
